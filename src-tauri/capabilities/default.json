{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions required by the main desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/allenk/GeminiWatermarkTool"
        },
        {
          "url": "https://github.com/jsonpreet/JV-Studio"
        },
        {
          "url": "https://github.com/jsonpreet/JV-Studio/**"
        }
      ]
    }
  ]
}
